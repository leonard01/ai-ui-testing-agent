{
  "name": "ai-ui-testing-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI-native UI test automation with human/AI browser collaboration (early-stage scaffold)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/run-regression.mjs",
    "test:ui": "playwright test --ui",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "demo": "node dist/demo/server.js",
    "agent": "node dist/cli.js",
    "generate": "node dist/generate-cli.js",
    "review": "node dist/review-server.js",
    "start": "npm run build && npm run review",
    "start:demo": "npm run build && node scripts/start-demo-and-review.mjs",
    "test:smoke": "npm run build && node scripts/run-regression.mjs --grep @e2e-smoke",
    "test:sanity": "node scripts/run-regression.mjs --grep \"@e2e-smoke|@sanity\"",
    "test:tokens": "node scripts/run-token-benchmarks.mjs",
    "test:low-spec": "node scripts/run-regression.mjs --profile=low-spec",
    "test:parallel": "node scripts/run-regression.mjs --profile=standard",
    "test:performance": "node scripts/run-regression.mjs --profile=performance"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "zod": "3.25.76",
    "gpt-tokenizer": "3.4.0"
  }
}
