# Copy this file to .env, then add your personal GroqCloud API key.
# Create a key at https://console.groq.com/keys
# Never commit or share .env or an actual API key.

# Required only when generating AI tests with GroqCloud.
GROQ_API_KEY=

# Optional: defaults to openai/gpt-oss-20b when omitted.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: experimental completion allowance, defaults to 2500 (256–5000).
# This is a maximum, including any reasoning tokens, not measured usage.
GROQ_MAX_COMPLETION_TOKENS=2500

# Optional controlled experiment: json (default, single model call), text (experimental), hybrid (legacy fallback, opt-in).
# Fixed modes disable automatic model-level correction/fallback.
GROQ_RESPONSE_POLICY=json

# Optional GPT-OSS reasoning effort: low, medium, high. Blank defaults to low for GPT-OSS 20B; other models retain provider default.
GROQ_REASONING_EFFORT=
